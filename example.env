# Copy to .env and fill in secrets: cp example.env .env
# Prereq: docker network create generative-cybersecurity-network

NVIDIA_VISIBLE_DEVICES=0,1

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

OPENAI_API_KEY=
HF_TOKEN=
HF_HOME=/app/models

# Workbench terminal-session (shell execution for execute_script)
TERMINAL_SESSION_URL=http://gencyber-workbench:3000

# Must match gencyber-ETL MongoDB credentials and service name `mongodb` on the shared network
MONGODB_URI=mongodb://mongouser:mongopassword@mongodb:27017
MONGODB_DATABASE=gencyber

REGISTRY_PATH=config/pipeline/default_pipeline_registry.yaml
