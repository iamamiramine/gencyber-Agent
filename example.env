# Copy to .env and fill in secrets: cp example.env .env
# Prereq: docker network create generative-cybersecurity-network

NVIDIA_VISIBLE_DEVICES=0,1

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# --- Langfuse (self-hosted) tracing. Leave the keys BLANK to disable tracing entirely
# (the agent then runs with zero Langfuse overhead). Point BASE_URL at your self-hosted
# Langfuse web container on the shared docker network. ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://langfuse-web:3000

OPENROUTER_API_KEY=
HF_TOKEN=
HF_HOME=/app/models

# --- gencyber-Engine (local open-source models via vLLM) ---
# The agent routes any model_name listed in config/models/engine_models.yaml to the
# engine instead of OpenRouter — you change ONLY the model name; the code decides.
# GENCYBER_ENGINE_BASE_URL is the engine endpoint on the shared docker network
# (container name). GENCYBER_ENGINE_API_KEY is optional (vLLM ignores it).
GENCYBER_ENGINE_BASE_URL=http://gencyber-engine:8000/v1
GENCYBER_ENGINE_API_KEY=
# Override the catalog path if needed (default shown):
# GENCYBER_ENGINE_CATALOG=config/models/engine_models.yaml
# Legacy Ollama endpoint (WhiteRabbit-* / LLama names route here):
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Model escalation ladder (weak base -> strong model on stall/bad-submit) ---
# These are the DEFAULTS; the init_workflow request can override per run
# (escalation_model / escalation_after_actions / escalation_provider / escalation_base_url).
# Set the model to off/none/empty to disable escalation. The agent never chooses the
# target — the operator does, here or per run.
GENCYBER_ESCALATION_MODEL=openai/gpt-5-mini
GENCYBER_ESCALATION_AFTER_ACTIONS=12

# Workbench terminal-session (shell execution for execute_script)
TERMINAL_SESSION_URL=http://gencyber-workbench:3000

# --- Execution tuning (all optional; sane defaults shown) ---
# Default timeout (s) for ordinary commands; long-running scanners/crackers get more.
GENCYBER_DEFAULT_CMD_TIMEOUT=60
GENCYBER_LONG_CMD_TIMEOUT=300
# Where write_script saves files on the shared workbench volume.
GENCYBER_AGENT_SCRIPT_DIR=/workspace/.gencyber-agent-scripts
# --- Context caps (chars) for injected blocks ---
LLM_RECON_REPORT_MAX_CHARS=16000

# Must match gencyber-ETL MongoDB credentials and service name `mongodb` on the shared network
MONGODB_URI=mongodb://mongouser:mongopassword@mongodb:27017
MONGODB_DATABASE=gencyber

REGISTRY_PATH=config/pipeline/default_pipeline_registry.yaml
